#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

#define LAYER_default_layer 0
#define LAYER_keypad 1
#define LAYER_fn 2
#define LAYER_mod 3
#define LAYER_mouse 4
#define LAYER_mouse_slow 5
#define LAYER_mouse_fast 6
#define LAYER_mouse_warp 7
#define LAYER_symbol 8

/* Input Listeners */
&mmv_input_listener {
    LAYER_mouse_slow {
        layers = <LAYER_mouse_slow>;
        input-processors = <&zip_xy_scaler 1 9>;
    };
    LAYER_mouse_fast {
        layers = <LAYER_mouse_fast>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
    LAYER_mouse_warp {
        layers = <LAYER_mouse_warp>;
        input-processors = <&zip_xy_scaler 12 1>;
    };
};

&msc_input_listener {
    LAYER_mouse_slow {
        layers = <LAYER_mouse_slow>;
        input-processors = <&zip_scroll_scaler 1 9>;
    };
    LAYER_mouse_fast {
        layers = <LAYER_mouse_fast>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };
    LAYER_mouse_warp {
        layers = <LAYER_mouse_warp>;
        input-processors = <&zip_scroll_scaler 12 1>;
    };
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hl: hl {
            compatible = "zmk,behavior-hold-tap";
            label = "HL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        mvo: mvo {
            compatible = "zmk,behavior-hold-tap";
            label = "MVO";
            bindings = <&vo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    macros {
        vo: vo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>;

            label = "VO";
            tap-ms = <30>;
            wait-ms = <15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL        &kp N1       &kp N2     &kp N3    &kp N4     &kp N5   &tog 1                                                                   &mo 3        &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB          &kp Q        &kp W      &kp E     &kp R      &lt 1 T  &none                                                                    &none        &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC          &kp A        &kp S      &kp D     &kp F      &kp G    &none     &kp LCTRL  &kp LALT             &kp RCTRL       &kp RGUI       &none        &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&mt LSHFT GRAVE  &kp Z        &kp X      &kp C     &kp V      &kp B                         &mt LCTRL HOME       &mt RALT PG_UP                              &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2            &mvo 0 HOME  &lt 4 END  &kp LEFT  &kp RIGHT           &kp BSPC  &kp DEL    &lt 8 PAGE_DOWN      &lt 1 PG_DN     &mt RCTRL RET  &lt 8 SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        layer_keypad {
            display-name = "Kp";
            bindings = <
&kp C_BRI_DN  &kp C_BRI_UP  &kp C_PREV    &kp C_NEXT  &kp C_PP  &kp N5  &trans                                      &mo 3   &kp LEFT_PARENTHESIS   &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp PRINTSCREEN
&kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &none       &none     &trans  &none                                       &none   &kp RIGHT_PARENTHESIS  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp SCROLLLOCK
&kp CAPS      &none         &none         &none       &none     &none   &none   &trans  &trans      &trans  &trans  &none   &kp PERCENT            &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp C_PAUSE
&kp LSHFT     &none         &none         &none       &none     &none                   &trans      &trans                  &kp COMMA              &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &trans
&mo 2         &trans        &none         &none       &none             &trans  &trans  &trans      &trans  &trans  &trans                         &kp KP_N0   &kp KP_N0     &kp KP_DOT     &kp KP_ENTER     &trans
            >;
        };

        layer_fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        layer_mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_mouse {
            bindings = <
&trans  &trans          &trans     &trans     &trans     &trans  &trans                                      &trans          &trans          &trans        &trans           &trans  &trans  &trans
&trans  &trans          &trans     &trans     &trans     &trans  &trans                                      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans  &trans
&trans  &msc SCRL_UP    &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans  &trans  &trans      &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans  &trans
&trans  &msc SCRL_DOWN  &mo 5      &mo 6      &mo 7      &trans                  &trans      &trans                          &trans          &trans        &trans           &trans  &trans  &trans
&trans  &trans          &trans     &trans     &trans             &trans  &trans  &trans      &trans  &trans  &mkp LCLK                       &mkp RCLK     &trans           &trans  &trans  &trans
            >;
        };

        layer_mouse_slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_mouse_fast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_mouse_warp {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_symbol {
            bindings = <
&kp GRAVE      &kp LBKT       &kp LS(LPAR)  &kp LS(RPAR)   &kp RBKT      &kp DOT        &kp LS(EXCL)                                                &none   &sk LGUI        &sk LALT           &sk LCTRL     &sk LSHFT        &none     &none
&kp LS(EXCL)   &kp COMMA      &kp LS(LBRC)  &kp LS(RBRC)   &kp SEMI      &kp LS(QMARK)  &none                                                       &none   &kp BACKSPACE   &kp GRAVE          &kp SPACE     &kp RET          &none     &none
&kp LS(POUND)  &kp LS(CARET)  &kp EQUAL     &kp LS(UNDER)  &kp LS(DLLR)  &kp LS(STAR)   &none          &kp LS(AMPS)   &kp DOT         &none  &none  &none   &kp LEFT_ARROW  &kp DOWN_ARROW     &kp UP_ARROW  &kp RIGHT_ARROW  &kp HOME  &kp PG_UP
&trans         &kp LS(LT)     &kp LS(PIPE)  &kp MINUS      &kp LS(GT)    &kp FSLH                                     &kp LS(AT)      &none                 &kp SQT         &kp TAB            &kp LS(TAB)   &none            &kp END   &kp PG_DN
&none          &trans         &kp COMMA     &kp LS(DQT)    &kp LS(PLUS)                 &kp LC(SPACE)  &kp LS(COLON)  &trans          &none  &none  &trans                  &kp DOUBLE_QUOTES  &none         &none            &none     &none
            >;
        };
    };
};
